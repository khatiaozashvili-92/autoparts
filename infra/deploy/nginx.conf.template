# Reverse proxy for the demo deployment.
#
# Both services sit behind one hostname on purpose. The web app calls the API
# from the browser, so putting them on separate origins would mean the browser
# never sends the demo password to the API — and would drag CORS back in for
# no benefit. One origin, one password, no preflight.
#
# The app's own ports stay bound to loopback and the firewall only opens 80,
# 443 and SSH, so there is no way to reach the API around this password.

server {
    listen 80;
    listen [::]:80;
    server_name ${DEMO_HOST};

    # Let's Encrypt has to reach this path unauthenticated or the certificate
    # can never be issued or renewed.
    location /.well-known/acme-challenge/ {
        auth_basic off;
        root /var/www/html;
    }

    auth_basic "autoparts demo";
    auth_basic_user_file /etc/nginx/.htpasswd;

    # Uploads are small; this only needs to clear a partner CSV import.
    client_max_body_size 12m;

    location /api/ {
        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        # The API rate-limits one-time codes per IP. Without this every
        # visitor looks like the proxy and they share one bucket.
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Next.js dev-style HMR and RSC streaming both need the connection
        # upgraded rather than buffered.
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        "upgrade";
        proxy_buffering off;
    }
}
