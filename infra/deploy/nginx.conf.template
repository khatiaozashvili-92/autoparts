# Reverse proxy for the demo deployment.
#
# Both services sit behind one hostname on purpose. The web app calls the API
# from the browser, so putting them on separate origins would mean the gate
# cookie is never sent to the API, and would drag CORS back in for no benefit.
#
# The app's own ports stay bound to loopback and the firewall only opens 80,
# 443 and SSH, so there is no way to reach the API around this gate.

# ---------------------------------------------------------------------------
# Why a cookie and not HTTP Basic auth.
#
# Basic auth was the obvious choice and it is the wrong one here. Basic
# credentials travel in the `Authorization` header, and so do this app's bearer
# tokens -- a request carries one `Authorization` header or the other, never
# both. So every *authenticated* request arrived at nginx carrying
# `Authorization: Bearer ...`, failed the Basic check, and was answered with
# nginx's own 401. The client reads that 401 as "my token expired", tries to
# refresh, is refused again, clears its tokens and signs the visitor out. The
# result: signing in appeared to work, then instantly undid itself.
#
# A cookie occupies a different header, so it rides along with the bearer token
# instead of fighting it.
# ---------------------------------------------------------------------------
map $cookie_demo_pass $demo_ok {
    default 0;
    "${DEMO_PASSWORD}" 1;
}

server {
    listen 80;
    listen [::]:80;
    server_name ${DEMO_HOST};

    # Let's Encrypt has to reach this path unauthenticated or the certificate
    # can never be issued or renewed.
    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    # Uploads are small; this only needs to clear a partner CSV import.
    client_max_body_size 12m;

    # The gate itself is reachable without the cookie, or nobody could ever
    # get one.
    location = /__gate {
        root /var/www/gate;
        try_files /index.html =404;
    }

    location = /__unlock {
        add_header Set-Cookie "demo_pass=$arg_key; Path=/; Secure; HttpOnly; SameSite=Lax; Max-Age=2592000" always;
        return 302 https://$host/;
    }

    location /api/ {
        # A bare 401 rather than a redirect: this is answering fetch(), and a
        # redirect to an HTML page would surface as a JSON parse error.
        if ($demo_ok = 0) { return 401; }

        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        # The API rate-limits one-time codes per IP. Without this every
        # visitor looks like the proxy and they share one bucket.
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Swagger sits outside the API's /api/v1 prefix, so it needs its own rule
    # or the footer's "API" link lands on the Next app and 404s. Still behind
    # the gate: it documents every endpoint this deployment exposes.
    location /docs {
        if ($demo_ok = 0) { return 302 https://$host/__gate; }

        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        if ($demo_ok = 0) { return 302 https://$host/__gate; }

        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Next.js streams its server-rendered payloads; buffering them delays
        # every navigation until the whole response is in.
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        "upgrade";
        proxy_buffering off;
    }
}
