{
  "name": "autoparts",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "pnpm test:unit && pnpm test:e2e",
    "clean": "turbo run clean && rimraf node_modules",
    "db:migrate": "pnpm --filter @autoparts/db migrate",
    "db:migrate:status": "pnpm --filter @autoparts/db migrate:status",
    "db:seed": "pnpm --filter @autoparts/db seed",
    "db:reset": "pnpm --filter @autoparts/db reset",
    "test:e2e": "node tests/run-all.mjs",
    "test:unit": "pnpm --filter @autoparts/core test && pnpm --filter @autoparts/api-client test && pnpm --filter @autoparts/providers test && pnpm --filter @autoparts/fitment test"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "rimraf": "^6.0.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [],
    "overrides": {
      "@types/react-dom": "19.3.0",
      "next>@types/react": "19.3.0"
    }
  }
}
