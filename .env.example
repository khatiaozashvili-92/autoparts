# ─── App ──────────────────────────────────────────────────────────────
NODE_ENV=development
API_PORT=3001
WEB_PORT=3000
API_URL=http://localhost:3001

# ─── Database ─────────────────────────────────────────────────────────
# Step 2-ზე გახდება სავალდებულო. Step 1-ზე ცარიელი = API მაინც ეშვება.
DATABASE_URL=postgresql://autoparts:autoparts@127.0.0.1:5433/autoparts

# ─── Redis (cache, locks, queues) ────────────────────────────────────
REDIS_URL=

# ─── Search ───────────────────────────────────────────────────────────
OPENSEARCH_URL=

# ─── Auth ─────────────────────────────────────────────────────────────
JWT_SECRET=dev-only-change-me-in-production
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
VIN_ENCRYPTION_KEY=dev-only-32-byte-key-change-me!!

# ─── Providers (docs/02 §7.1) ────────────────────────────────────────
FITMENT_PROVIDER_PRIMARY=mock
FITMENT_PROVIDER_FALLBACK=mock
PAYMENT_PROVIDER=mock

# ─── Locale defaults — default, არა hardcode (PRD §80) ───────────────
DEFAULT_COUNTRY=GE
DEFAULT_CURRENCY=GEL
DEFAULT_LOCALE=ka

# ─── Feature flags ────────────────────────────────────────────────────
FEATURE_REQUEST_PART=false
FEATURE_COURIER_DELIVERY=false
FEATURE_REVIEWS=false

# ─── Fitment engine ───────────────────────────────────────────────────
FITMENT_MIN_CONFIDENCE=0.50
RESERVATION_TTL_MINUTES=15
PICKUP_DEADLINE_HOURS=24
