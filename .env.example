# ─── App ──────────────────────────────────────────────────────────────
NODE_ENV=development
API_PORT=3001
WEB_PORT=3000
API_URL=http://localhost:3001

# ─── Database ─────────────────────────────────────────────────────────
# Step 2-ზე გახდება სავალდებულო. Step 1-ზე ცარიელი = API მაინც ეშვება.
DATABASE_URL=postgresql://autoparts:autoparts@127.0.0.1:5433/autoparts

# ─── Redis (cache, locks, queues) ────────────────────────────────────
REDIS_URL=

# ─── Search ───────────────────────────────────────────────────────────
OPENSEARCH_URL=

# ─── Auth ─────────────────────────────────────────────────────────────
JWT_SECRET=dev-only-change-me-in-production
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
VIN_ENCRYPTION_KEY=dev-only-32-byte-key-change-me!!

# ─── Providers (docs/02 §7.1) ────────────────────────────────────────
FITMENT_PROVIDER_PRIMARY=mock
FITMENT_PROVIDER_FALLBACK=mock
PAYMENT_PROVIDER=mock

# The browser calls the API at this origin. Inlined into the client bundle at
# BUILD time, so changing it needs a rebuild, not just a restart. Point it at
# the public origin when deploying; same-origin keeps CORS out of the picture.
NEXT_PUBLIC_API_URL=http://localhost:3001

# Authentication is a phone number plus a one-time SMS code (ADR-015).
# 'console' prints the code to the API log instead of sending it; OTP_ECHO_CODE
# also returns it in the response so the login page can show it. Both are
# refused when NODE_ENV=production.
SMS_PROVIDER=console

# ── switching on real SMS ───────────────────────────────────────────
# Set SMS_PROVIDER to twilio or http and fill in the matching block. The
# API refuses to start if the chosen gateway is missing its credentials,
# so a misconfiguration is caught at boot and not on a customer sign-in.
#
# Twilio: no local company needed, so it can be switched on the same day.
# TWILIO_ACCOUNT_SID=AC...
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=autoparts        # a registered sender ID, or a number
#
# Any Georgian aggregator with a plain HTTP endpoint. The parameter NAMES
# come from that provider documentation -- do not guess them.
# SMS_HTTP_URL=https://api.example.ge/send
# SMS_HTTP_TO_PARAM=destination
# SMS_HTTP_TEXT_PARAM=content
# SMS_HTTP_SENDER_PARAM=sender
# SMS_HTTP_SENDER=autoparts
# SMS_HTTP_KEY_PARAM=key
# SMS_HTTP_KEY=
# SMS_HTTP_STRIP_PLUS=true     # many local gateways reject a leading +
# SMS_HTTP_SUCCESS_PATTERN=^OK # these often answer 200 and say no in the body
OTP_ECHO_CODE=true
OTP_TTL_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_MAX_PER_HOUR=5

# ─── Locale defaults — default, არა hardcode (PRD §80) ───────────────
DEFAULT_COUNTRY=GE
DEFAULT_CURRENCY=GEL
DEFAULT_LOCALE=ka

# ─── Feature flags ────────────────────────────────────────────────────
FEATURE_REQUEST_PART=false
FEATURE_COURIER_DELIVERY=false
FEATURE_REVIEWS=false

# ─── Fitment engine ───────────────────────────────────────────────────
FITMENT_MIN_CONFIDENCE=0.50
RESERVATION_TTL_MINUTES=15
PICKUP_DEADLINE_HOURS=24
